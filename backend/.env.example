# SuiLoyalty Backend — environment template.
#
# Copy this file to backend/.env and fill in your own values.
# .env is gitignored — it must NEVER be committed.
# CI uses dummy placeholders set inline in .github/workflows/backend.yml
# because the Jest suite mocks the blockchain and pg pool. Anything secret
# in CI must come from ${{ secrets.* }}, not from a hardcoded YAML value.

# ─── App ──────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://localhost:5432/suiloyalty

# ─── Sui network + deployment ─────────────────────────────────────────────────
SUI_NETWORK=testnet
# Backend wallet that holds AdminCap, TreasuryCap, TokenAdminCap.
# Generate with: sui client new-address ed25519
SUI_PRIVATE_KEY=suiprivkey1...replace-me...
SUI_BACKEND_ADDRESS=0x...replace-me...
# Sui-side IDs from your testnet deployment of contracts/.
SUI_PACKAGE_ID=0x...replace-me...
ADMIN_CAP_ID=0x...replace-me...
TREASURY_CAP_ID=0x...replace-me...
TOKEN_ADMIN_CAP_ID=0x...replace-me...
UPGRADE_CAP_ID=0x...replace-me...

# ─── Google OAuth (zkLogin) ───────────────────────────────────────────────────
# Register the redirect URI in Google Cloud Console exactly as written here.
REDIRECT_URI=http://localhost:3000/api/auth/callback
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-replace-me

# ─── App secrets ──────────────────────────────────────────────────────────────
# Long random strings. Rotate if leaked.
ZKLOGIN_SALT_SECRET=replace-with-long-random-string
QR_HMAC_SECRET=replace-with-long-random-string
SESSION_SECRET=replace-with-long-random-string

# ─── Optional ────────────────────────────────────────────────────────────────
# Sponsor key for sponsored transactions if separated from SUI_PRIVATE_KEY.
# Currently the same wallet pays gas and signs on behalf of customers.
SUI_SPONSOR_KEY=suiprivkey1...replace-me...
# Phone testing — your dev machine's LAN IP, used in startup log only.
# LOCAL_LAN_IP=192.168.1.48
