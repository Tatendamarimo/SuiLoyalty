# SuiLoyalty Frontend — local environment template.
#
# Copy this file to frontend/.env.local and fill in your own values.
# .env.local is gitignored — it must NEVER be committed.
#
# Only NEXT_PUBLIC_* keys are safe to put here. Anything without that
# prefix could still be inlined into a server-rendered page if referenced
# carelessly, and any frontend build that ships JS to the browser must
# never see a server-side secret. Server-only secrets (Google client
# secret, Sui private keys, DB URL, salt secret) belong exclusively in
# backend/.env.

NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
NEXT_PUBLIC_SUI_NETWORK=testnet
